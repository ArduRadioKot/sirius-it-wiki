<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_lesson_row" android:layout_width="match_parent" android:layout_height="26dp" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:id="@+id/widget_lesson_time" android:layout_width="42dp" android:layout_height="wrap_content" android:textColor="#62E5E0" android:textSize="12sp" android:singleLine="true" android:ellipsize="end"/>
<TextView android:id="@+id/widget_lesson_name" android:layout_width="0dp" android:layout_height="wrap_content" android:textColor="#F4F8F8" android:textSize="13sp" android:singleLine="true" android:ellipsize="end" android:layout_weight="1"/>
<TextView android:id="@+id/widget_lesson_room" android:layout_width="70dp" android:layout_height="wrap_content" android:textColor="#A7C7CB" android:textSize="10sp" android:singleLine="true" android:ellipsize="end" android:gravity="end"/>
</LinearLayout>
