<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="9dp" android:background="@drawable/widget_background">
<TextView android:id="@+id/widget_kicker" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#62E5E0" android:textSize="11sp" android:singleLine="true"/>
<TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F4F8F8" android:textSize="14sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end"/>
<TextView android:id="@+id/widget_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#A7C7CB" android:textSize="11sp" android:singleLine="true" android:ellipsize="end"/>
</LinearLayout>
